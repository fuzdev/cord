# Local development env for `cordd`, the Rust server.
# Copy to `.env.development` (gitignored) and load it into the shell that runs
# `cargo run -p cord_server`; `cordd` reads only its process env, never this file.

# Database (create with: createdb cord)
DATABASE_URL=postgres://localhost/cord

# Bind address (defaults to 127.0.0.1:4061, where the Vite dev proxy points)
#HOST=127.0.0.1
#PORT=4061

# Cookie-signing keys, at least 32 characters each (openssl rand -base64 32).
# For rotation, join keys with __ (new_key__old_key); the first one signs.
SECRET_FUZ_COOKIE_KEYS=

# Origins allowed to call the API (required; an empty list refuses to boot).
# Patterns: https://cord.example, https://*.example, http://localhost:*
FUZ_ALLOWED_ORIGINS=http://localhost:*

# One-shot token file for creating the first account; while it exists and no
# account does, POST /api/account/bootstrap is open.
# The file must be owner-only (0600) and exist before cordd starts. Create with:
# mkdir -p ~/.cord && (umask 077; openssl rand -hex 32 > ~/.cord/secret_bootstrap_token)
FUZ_BOOTSTRAP_TOKEN_PATH=~/.cord/secret_bootstrap_token

# Reverse-proxy hops trusted for X-Forwarded-For (comma-separated IPs/CIDRs).
# Leave unset in dev; set to 127.0.0.1 behind a local nginx.
#CORD_TRUSTED_PROXIES=
