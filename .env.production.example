# Operator env for deploying Cord with zap. Copy to `.env.production`
# (gitignored) and fill in the blanks; see DEPLOY.md.
#
# zap reads this file on your machine, only to resolve the `zap.env('NAME')`
# references in zap.ts. None of it is copied to the host as is: zap generates
# the host's env file for `cordd` from the template in zap.ts, and every
# wetrun needs each value below set.

# The host's address (IP or hostname) that zap connects to over SSH
DEPLOY_HOST=

# The SSH login on the fresh host, used only by `zap apply --bootstrap`
# (root on a stock Debian image, holding your SSH key)
BOOTSTRAP_USER=root

# The public domain; its DNS A (and AAAA) record must point at the host
DEPLOY_DOMAIN=cord.example.com

# The email Let's Encrypt registers the certificate under
DEPLOY_CERTBOT_EMAIL=

# Cookie-signing keys, 32+ characters each; generate one with:
#   openssl rand -base64 32
# To rotate, join keys with __ (new_key__old_key); the first one signs.
SECRET_FUZ_COOKIE_KEYS=

# For reference, the host-side env zap writes to shared/.env.production
# (don't set these here; change them in zap.ts):
#   PORT=4061 and HOST=127.0.0.1, where nginx proxies
#   DATABASE_URL=postgres://cord@localhost/cord
#   FUZ_BOOTSTRAP_TOKEN_PATH=/home/cord/.cord/secret_bootstrap_token
#   FUZ_ALLOWED_ORIGINS=https://<DEPLOY_DOMAIN>
#   CORD_TRUSTED_PROXIES=127.0.0.1, so the per-IP limits see the client, not nginx
#   NO_COLOR=1, for plain-text logs in journald
#   SECRET_FUZ_COOKIE_KEYS, from above
