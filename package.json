{
  "name": "@fuzdev/cord",
  "version": "0.0.1",
  "description": "self-hosted voice, video, chat, and forums for connection with your people",
  "glyph": "🔌",
  "logo": "logo.svg",
  "logo_alt": "two teal socket faces leaning apart, a plug reaching toward each, joined by one looped cord",
  "license": "0BSD",
  "private": true,
  "homepage": "https://github.com/fuzdev/cord",
  "repository": "https://github.com/fuzdev/cord",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "build:site": "PUBLIC_CORD_SITE=true gro build",
    "check": "gro check",
    "test": "gro test",
    "test:cross": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_rust",
    "preview": "vite preview",
    "validate": "zap config validate --env-file .env.production zap.ts",
    "plan": "zap plan --env-file .env.production zap.ts",
    "apply": "zap apply --env-file .env.production zap.ts",
    "apply:bootstrap": "zap apply --env-file .env.production --bootstrap zap.ts",
    "deploy": "zap deploy --env-file .env.production zap.ts",
    "deploy:site": "PUBLIC_CORD_SITE=true gro deploy"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.1",
    "@fuzdev/fuz_app": "^0.183.0",
    "@fuzdev/fuz_code": "^0.61.0",
    "@fuzdev/fuz_css": "^0.83.0",
    "@fuzdev/fuz_schema": "^0.6.1",
    "@fuzdev/fuz_ui": "^0.231.0",
    "@fuzdev/fuz_util": "^0.83.0",
    "@fuzdev/gro": "^0.239.0",
    "@fuzdev/mdz": "^0.11.0",
    "@fuzdev/zap": "0.1.0",
    "@ryanatkn/eslint-config": "^0.13.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.12.4",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "esm-env": "^1.2.2",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svelte2tsx": "^0.7.63",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.22.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ]
}
