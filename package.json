{
  "name": "@ryanatkn/cord",
  "version": "0.0.1",
  "description": "a self-hosted hangout for friend groups and small communities: voice and video rooms, chat, forums, and Bluesky feeds",
  "license": "0BSD",
  "private": true,
  "repository": "https://github.com/ryanatkn/cord",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "test:cross": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_rust",
    "preview": "vite preview",
    "validate": "zap config validate --env-file .env.production zap.ts",
    "plan": "zap plan --env-file .env.production zap.ts",
    "apply": "zap apply --env-file .env.production zap.ts",
    "apply:bootstrap": "zap apply --env-file .env.production --bootstrap zap.ts",
    "deploy": "zap deploy --env-file .env.production zap.ts"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_app": "^0.175.0",
    "@fuzdev/fuz_code": "^0.59.0",
    "@fuzdev/fuz_css": "^0.81.0",
    "@fuzdev/fuz_schema": "^0.5.6",
    "@fuzdev/fuz_ui": "^0.228.0",
    "@fuzdev/fuz_util": "^0.82.0",
    "@fuzdev/gro": "^0.237.0",
    "@fuzdev/mdz": "^0.9.0",
    "@fuzdev/zap": "0.1.0",
    "@ryanatkn/eslint-config": "^0.13.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.12.4",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "esm-env": "^1.2.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte2tsx": "^0.7.56",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "ws": "^8.22.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ]
}
